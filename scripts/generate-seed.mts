// Generates the starter-content migration from src/lib/data/defaults.ts:
//   node --experimental-strip-types scripts/generate-seed.mts > supabase/migrations/20261020000100_starter_content.sql
// It is a migration (not seed.sql) because Supabase applies migrations on production deploys.
// Only regenerate it before it has been applied anywhere; afterwards edit content in the admin area.
import { DEFAULT_SETTINGS, demoMedia } from "../src/lib/data/defaults.ts";

const q = (v: unknown) => `'${JSON.stringify(v).replace(/'/g, "''")}'::jsonb`;
const s = (v: string) => `'${v.replace(/'/g, "''")}'`;

const lines = [
  "-- Starter content for a fresh project. Never overwrites: existing rows are kept.",
  "-- Generated by scripts/generate-seed.mts from src/lib/data/defaults.ts.",
  "",
  ...(["property", "homepage", "pricing"] as const).map(
    (key) => `insert into site_settings (key, value) values (${s(key)}, ${q(DEFAULT_SETTINGS[key])}) on conflict (key) do nothing;`,
  ),
  "",
  "-- Placeholder photos (served from /public/demo). Replace them in Admin → Снимки.",
  "insert into media (url, alt_bg, alt_en, sort_order, in_carousel, in_gallery)",
  "select * from (values",
  demoMedia("").map((m) => `  (${s(m.url)}, ${s(m.alt.bg)}, ${s(m.alt.en)}, ${m.sortOrder}, ${m.inCarousel}, ${m.inGallery})`).join(",\n"),
  ") as v(url, alt_bg, alt_en, sort_order, in_carousel, in_gallery)",
  "where not exists (select 1 from media);",
  "",
];
console.log(lines.join("\n"));
