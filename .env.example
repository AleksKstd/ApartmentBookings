# Copy to .env.local and fill in. With nothing set, the app runs in local demo mode.

# --- Public site URL (used in emails, Stripe redirects, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Supabase (database + photo storage). Both required for production. ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Server-only secret. NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---
ADMIN_USERNAME=owner
# Generate with: npm run hash-password -- "a long passphrase"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. `npm run generate-secrets` prints this, ICAL_EXPORT_TOKEN and CRON_SECRET.
# Required in every production build (also with DEMO_MODE=true).
ADMIN_SESSION_SECRET=

# --- Stripe (optional; without it bookings are requests the host confirms) ---
# sk_test_… while testing, sk_live_… for real payments
STRIPE_SECRET_KEY=
# whsec_… from Stripe → Developers → Webhooks (endpoint: https://YOUR-DOMAIN/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (optional; without it emails are only logged in Admin → Имейли) ---
RESEND_API_KEY=
EMAIL_FROM="Morski Briz <bookings@your-domain.com>"
# Where new-booking notifications go (defaults to the contact email in Admin → Съдържание)
ADMIN_NOTIFICATION_EMAIL=

# --- Calendar synchronisation (Booking.com, Airbnb, …) ---
# Secret token in the iCal export URLs you give Booking.com/Airbnb (≥16 random characters)
ICAL_EXPORT_TOKEN=
# Bearer token for /api/cron/sync-calendars (Vercel Cron and the GitHub workflow send it; ≥16 characters)
CRON_SECRET=

# --- Demo mode in a production build (e.g. a preview deployment) ---
# DEMO_MODE=true
