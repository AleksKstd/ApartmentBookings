# Copy to .env.local and fill in. With nothing set, the app runs in local demo mode.

# --- Public site URL (used in emails, Stripe redirects, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Supabase (database + photo storage). Both required for production. ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Server-only secret. NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---
ADMIN_USERNAME=owner
# Generate with: npm run hash-password -- "a long passphrase"
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=

# --- Stripe (optional; without it bookings are requests the host confirms) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (optional; without it emails are only logged in Admin → Имейли) ---
RESEND_API_KEY=
EMAIL_FROM="Morski Briz <bookings@your-domain.com>"
# Where new-booking notifications go (defaults to the contact email in Admin → Съдържание)
ADMIN_NOTIFICATION_EMAIL=

# --- Calendar synchronisation ---
# Secret token for the iCal export URL given to Airbnb/Booking.com (≥16 random characters)
ICAL_EXPORT_TOKEN=
# Bearer token for /api/cron/sync-calendars (Vercel Cron sends it automatically)
CRON_SECRET=

# --- Demo mode in a production build (e.g. a preview deployment) ---
# DEMO_MODE=true
